# Replay the bundled SMPL jump clip to GearSonicInterface in real time.
#
# This is a thin wrapper that locates the jump data shipped in this package's
# share/data directory and hands it to replay_smpl_motion.py, which publishes the
# motion frame-by-frame on <prefix>/smpl_motion at 50 Hz (GearSonicInterface then
# forwards each frame to the SONIC deploy over ZMQ).
#
# Prerequisites:
#   1. gear_sonic deploy running with: ./deploy.sh --input-type zmq_manager <sim|real>
#   2. GearSonicInterface node running: ros2 run g1_hardware gear_sonic_interface_node
#
# Usage:
#   ros2 run g1_hardware example_smpl_jump            # jump 1 (default)
#   ros2 run g1_hardware example_smpl_jump 2          # jump 2
#   ros2 run g1_hardware example_smpl_jump 3 -p rate:=50.0   # jump 3 + extra params
#
# The first positional argument selects the bundled clip (1/2/3, default 1).
# Any remaining arguments are passed through to replay_smpl_motion.py.
#
# replay_smpl_motion.py handles the full sequence: enable_control (balance) ->
# enable_smpl_stream (streamed motion) -> publish the jump -> enable_smpl_stream off.

set -euo pipefail

# First positional arg = jump number (1/2/3). Default 1. Only consumed if numeric,
# so extra "-p ..." params can be passed without specifying a jump number.
JUMP=1
if [ "$#" -ge 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
  JUMP="$1"
  shift
fi

PKG_SHARE="$(ros2 pkg prefix g1_hardware)/share/g1_hardware"
CLIP="${PKG_SHARE}/data/smpl_jump${JUMP}.npz"

if [ ! -f "${CLIP}" ]; then
  echo "[example_smpl_jump] jump data not found: ${CLIP}" >&2
  echo "[example_smpl_jump] available: $(ls "${PKG_SHARE}/data/" 2>/dev/null | tr '\n' ' ')" >&2
  echo "[example_smpl_jump] did you build & source the workspace?" >&2
  exit 1
fi

echo "[example_smpl_jump] replaying jump ${JUMP}: ${CLIP}"
exec ros2 run g1_hardware replay_smpl_motion.py --ros-args -p clip:="${CLIP}" "$@"
