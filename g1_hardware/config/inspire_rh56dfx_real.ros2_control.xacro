<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
      Real-hardware ros2_control configuration for Inspire Robots RH56DFX.
      The external inspire_g1 bridge owns the serial devices and exposes:
        rt/inspire/cmd   unitree_go::msg::dds_::MotorCmds_
        rt/inspire/state unitree_go::msg::dds_::MotorStates_
      RH56DFX DDS q values are normalized as 0.0 = closed, 1.0 = open.
    -->
  <xacro:macro name="inspire_rh56dfx_ros2_control" params="name network_interface:='' command_topic:='rt/inspire/cmd' state_topic:='rt/inspire/state' state_timeout_sec:=3.0">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>g1_hardware/InspireRH56DFXHardwareInterface</plugin>
        <param name="network_interface">${network_interface}</param>
        <param name="command_topic">${command_topic}</param>
        <param name="state_topic">${state_topic}</param>
        <param name="state_timeout_sec">${state_timeout_sec}</param>
      </hardware>
      <!-- Right RH56DFX hand - actuated joints only (URDF mimic joints excluded) -->
      <joint name="R_thumb_proximal_yaw_joint">
        <command_interface name="position">
          <param name="min">-0.1</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="R_thumb_proximal_pitch_joint">
        <command_interface name="position">
          <param name="min">-0.1</param>
          <param name="max">0.6</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="R_index_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="R_middle_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="R_ring_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="R_pinky_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <!-- Left RH56DFX hand - actuated joints only (URDF mimic joints excluded) -->
      <joint name="L_thumb_proximal_yaw_joint">
        <command_interface name="position">
          <param name="min">-0.1</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="L_thumb_proximal_pitch_joint">
        <command_interface name="position">
          <param name="min">-0.1</param>
          <param name="max">0.6</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="L_index_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="L_middle_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="L_ring_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="L_pinky_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.7</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
