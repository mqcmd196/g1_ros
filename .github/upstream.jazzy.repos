repositories:
  unitreerobotics/unitree_ros:
    type: git
    url: https://github.com/mqcmd196/unitree_ros
    version: description-package
  unitreerobotics/unitree_sdk2:
    type: git
    url: https://github.com/mqcmd196/unitree_sdk2.git
    version: add-package-xml
  # NOTE: FAST-LIO (g1_navigation odometry) is intentionally NOT built in CI.
  # It is a runtime-only dep of g1_navigation (launch/config), so it is skipped
  # via ROSDEP_SKIP_KEYS in ci.yml instead. See jazzy.repos.yaml for real builds.
